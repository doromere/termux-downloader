#!/data/data/com.termux/files/usr/bin/bash
# termux-file-editor — вызывается, когда через «Поделиться → Termux» пришёл
# файл или текст, который не является «чистой» ссылкой
# (например: «Смотри, какое видео https://youtu.be/...»).
#  - .csv / .txt-список треков (TuneMyMusic, Exportify…) → playlist-dump
#  - текст со ссылками  → ссылки передаются в termux-url-opener
#  - .torrent           → скачивается через aria2c (после подтверждения)
#  - любой другой файл  → Download/Termux Downloads/Shared Files/

FILE="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
OPENER="$HOME/bin/termux-url-opener"
[ -x "$OPENER" ] || OPENER="$SCRIPT_DIR/termux-url-opener"
PLD="$HOME/bin/playlist-dump"
[ -x "$PLD" ] || PLD="$SCRIPT_DIR/playlist-dump"
TDL="$HOME/bin/termux-dl"
[ -x "$TDL" ] || TDL="$SCRIPT_DIR/termux-dl"
[ -x "$TDL" ] || TDL="$(command -v termux-dl 2>/dev/null || true)"

CFG_ROOT=""
if [ -n "$TDL" ] && [ -x "$TDL" ]; then
  while IFS='=' read -r k v; do
    [ "$k" = "CFG_ROOT" ] && CFG_ROOT="$v"
  done < <("$TDL" config env 2>/dev/null)
fi
ROOT="${TUO_ROOT:-${CFG_ROOT:-$HOME/storage/shared/Download/Termux Downloads}}"
ROOT="${ROOT/#\~/$HOME}"

pause() { read -r -n 1 -s -t "${1:-10}" -p "Окно закроется через ${1:-10} с (или нажмите любую клавишу)…"; echo; }

[ -f "$FILE" ] || { echo "Файл не найден: $FILE"; exit 1; }
name=$(basename "$FILE")
is_text=0; grep -Iq . "$FILE" 2>/dev/null && is_text=1

run_playlist_dump() {
  if [ -x "$PLD" ]; then exec "$PLD" --keep-dump "$FILE"; fi
  echo "✘ playlist-dump не установлен. Обновите: cd ~/termux-downloader && git pull && bash install.sh"
  pause 30; exit 1
}

case "${name,,}" in
  *.torrent) exec "$OPENER" "$FILE" ;;
  *.csv)     [ "$is_text" = 1 ] && run_playlist_dump ;;
esac

if [ "$is_text" = 1 ]; then
  # Сначала ищем ссылки (через termux-dl, с фолбэком на grep)
  if [ -n "$TDL" ] && [ -x "$TDL" ]; then
    mapfile -t urls < <("$TDL" extract --file "$FILE")
  else
    mapfile -t urls < <(grep -oE '(https?://|magnet:\?)[^[:space:]<>"]+' "$FILE" | awk '!seen[$0]++' | head -n 200)
    if [ ${#urls[@]} -eq 0 ]; then
      mapfile -t urls < <(grep -oiE '(^|[[:space:](])(www\.)?([a-z0-9-]+\.)+[a-z]{2,}/[^[:space:]<>"]*' "$FILE" \
                          | sed -E 's/^[[:space:](]+//' | awk '!seen[$0]++' | head -n 200)
    fi
  fi

  lines=$(grep -c '[^[:space:]]' "$FILE")
  if [ ${#urls[@]} -gt 0 ]; then
    # Список треков Spotify (3+ строк и все ссылки — треки Spotify) → playlist-dump;
    # иначе передаём найденные ссылки в termux-url-opener
    foreign=$(printf '%s\n' "${urls[@]}" | grep -vcE '^(https?://)?open\.spotify\.com/(intl-[a-z-]+/)?track/')
    if [ "$lines" -ge 3 ] && [ "$foreign" -eq 0 ]; then
      run_playlist_dump
    fi
    # исходный текст удаляем только после успешной загрузки — при ошибке он остаётся в ~/downloads
    "$OPENER" "${urls[@]}"
    rc=$?
    [ $rc -eq 0 ] && rm -f "$FILE"
    exit $rc
  fi

  # Текст без ссылок: считаем списком треков, только если 3+ непустых строк и есть строки «Исполнитель - Название» / spotify:track:
  track_lines=$(grep -cE '([[:space:]][-–—][[:space:]]|^spotify:track:)' "$FILE")
  if [ "$lines" -ge 3 ] && [ $((track_lines * 2)) -ge "$lines" ]; then
    run_playlist_dump
  fi
fi

dest="$ROOT/Shared Files"
mkdir -p "$dest" || { echo "✘ Нет доступа к памяти телефона (termux-setup-storage)"; pause 30; exit 1; }
target="$dest/$name"
if [ -e "$target" ]; then
  base="${name%.*}"; ext="${name##*.}"
  [ "$base" = "$name" ] && ext="" || ext=".$ext"
  target="$dest/${base}_$(date +%Y%m%d-%H%M%S)$ext"
fi
mv "$FILE" "$target" && echo "✔ Сохранено: Download/Termux Downloads/Shared Files/$(basename "$target")"
pause 10
