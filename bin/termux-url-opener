#!/data/data/com.termux/files/usr/bin/bash
# =====================================================================
#  termux-url-opener — универсальный загрузчик для «Поделиться → Termux»
#
#  Куда сохраняется:
#    Внутренняя память/Download/Termux Downloads/<Сервис>/
#
#  Команды:
#    termux-url-opener <ссылка или текст со ссылками>
#    termux-url-opener --update   обновить yt-dlp, gallery-dl, gdown
#    termux-url-opener --doctor   проверить память, зависимости и права
#    termux-url-opener --config [show|get|set|reset]  настройки по умолчанию
#    termux-url-opener --import файл.csv|txt    скачать плейлист из дампа
#    termux-url-opener --export ссылка_spotify  выгрузить плейлист в CSV/TXT
#    termux-url-opener --history [N]  последние N загрузок (журнал хранится приватно)
#    termux-url-opener --help
#
#  Cookies (для X/Twitter, Instagram, 18+ на YouTube и т.п.):
#    ~/.config/termux-downloads/cookies/<сервис>.txt   например twitter.txt
#    ~/.config/termux-downloads/cookies/cookies.txt    общий для всех
# =====================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
TDL="$HOME/bin/termux-dl"
[ -x "$TDL" ] || TDL="$SCRIPT_DIR/termux-dl"
[ -x "$TDL" ] || TDL="$(command -v termux-dl 2>/dev/null || true)"
PLD="$HOME/bin/playlist-dump"
[ -x "$PLD" ] || PLD="$SCRIPT_DIR/playlist-dump"

CONF="$HOME/.config/termux-downloads"
COOKIES_DIR="$CONF/cookies"
LOG="$CONF/history.log"
DRY="${TUO_DRY_RUN:-0}"

usage() {
  sed -n '3,/^# =====/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

update_tools() {
  local py=python
  command -v python3.13 >/dev/null 2>&1 && py=python3.13
  "$py" -m pip install -U "yt-dlp[default]" gallery-dl gdown && printf '\e[32m✔ %s\e[0m\n' "yt-dlp, gallery-dl и gdown обновлены."
  command -v node >/dev/null 2>&1 || pkg install -y nodejs-lts
  echo "spotDL обновляется отдельно (нужен rust):"
  echo "  pkg install -y rust binutils && ANDROID_API_LEVEL=\$(getprop ro.build.version.sdk) $py -m pip install -U spotdl"
}

require_tdl() {
  [ -n "$TDL" ] && [ -x "$TDL" ] && return 0
  printf '\e[31m✘ %s\e[0m\n' "termux-dl не найден. Переустановите: bash install.sh" >&2
  exit 1
}

case "$1" in
  -h|--help) usage; exit 0 ;;
  --update)  update_tools; exit $? ;;
  --doctor)  require_tdl; exec "$TDL" doctor ;;
  --config)  require_tdl; shift; exec "$TDL" config "$@" ;;
  --import)  shift; exec "$PLD" "$@" ;;
  --export)  shift; exec "$PLD" export "$@" ;;
  --history) [ -f "$LOG" ] && tail -n "${2:-30}" "$LOG" || echo "Журнал пуст."; exit 0 ;;
  "")        usage; exit 1 ;;
esac

require_tdl

if [ "$DRY" != 1 ] && [ ! -d "$HOME/storage/shared" ]; then
  printf '\e[36m%s\e[0m\n' "Нужен доступ к памяти телефона — разрешите его в появившемся окне."
  termux-setup-storage; sleep 4
fi
if [ "$DRY" != 1 ]; then
  mkdir -p "$CONF" "$COOKIES_DIR" 2>/dev/null
  chmod 700 "$CONF" "$COOKIES_DIR" 2>/dev/null
  umask 077 2>/dev/null; touch "$LOG" 2>/dev/null; umask 022
fi

if [ -f "$1" ]; then
  case "${1,,}" in
    *.torrent)
      "$TDL" torrent "$1"
      rc=$?
      [ "$DRY" = 1 ] || read -r -n 1 -s -p "Нажмите любую клавишу для выхода…"
      exit $rc ;;
  esac
fi

"$TDL" run "$@"
rc=$?
if [ "$DRY" != 1 ]; then
  if [ $rc -eq 0 ]; then
    read -r -n 1 -s -t 10 -p "Окно закроется через 10 с (или нажмите любую клавишу)…"
  else
    read -r -n 1 -s -p "Нажмите любую клавишу для выхода…"
  fi
  echo
fi
exit $rc
