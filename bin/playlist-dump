HOME = Path.home()
# expanduser: TUO_ROOT="~/…" в кавычках shell не раскрывает
ROOT = Path(os.environ.get("TUO_ROOT") or HOME / "storage/shared/Download/Termux Downloads").expanduser()
COOKIES_DIR = HOME / ".config/termux-downloads/cookies"
SEARCH_DIRS = [
    HOME / "storage/shared/Download",
    HOME / "storage/shared/Documents",
    ROOT / "Shared Files",
    ROOT / "Playlists",
    HOME / "downloads",
]
CACHE_NAME = ".playlist-dump.json"
PID = os.getpid()  # во временных файлах — чтобы параллельные запуски не мешали друг другу
UA = "Mozilla/5.0 (Linux; Android 14) termux-downloader"

C_OK, C_ERR, C_INF, C_WARN, C_B, C_0 = "\033[32m", "\033[31m", "\033[36m", "\033[33m", "\033[1m", "\033[0m"


def say(msg):
    print(f"{C_INF}{msg}{C_0}", flush=True)


def ok(msg):
    print(f"{C_OK}✔ {msg}{C_0}", flush=True)


def warn(msg):
    print(f"{C_WARN}! {msg}{C_0}", flush=True)


def err(msg):
    print(f"{C_ERR}✘ {msg}{C_0}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Разбор дампов
# --------------------------------------------------------------------------
HEADER_MAP = {
    "title": ["track name", "track", "title", "name", "song", "song name", "track title",
              "название", "трек", "песня", "название трека"],
    "artist": ["artist name", "artist name(s)", "artist", "artists", "artist(s)", "artist names",
               "исполнитель", "исполнители", "артист"],
    "album": ["album", "album name", "album title", "альбом"],
    "isrc": ["isrc"],
    "spotify": ["spotify - id", "spotify id", "spotify_id", "track uri", "spotify uri", "uri",
                "spotify url", "url", "link", "spotify link", "track url", "track id"],
    "playlist": ["playlist name", "playlist", "плейлист"],
}
SPOTIFY_ID_RE = re.compile(
    r"(?:open\.spotify\.com/(?:intl-[\w-]+/)?track/|spotify:track:)([A-Za-z0-9]{22})")
BARE_ID_RE = re.compile(r"^[A-Za-z0-9]{22}$")
DASH_RE = re.compile(r"\s[-–—]\s")
NUM_DOT = re.compile(r"^\d{1,4}[.)]\s+")          # «1. Artist - Title», «01) …»
NUM_DASH = re.compile(r"^\d{1,4}\s*[-–—]\s+")     # «01 - Artist - Title» (spotDL --numbered)


def strip_num(s: str) -> str:
    """Убирает номер трека в начале строки/имени файла. «N - » убирается, только если
    дальше ещё есть « - » — иначе это часть имени: «311 - Amber», «50 - …»."""
    t = NUM_DOT.sub("", s, count=1)
    if t != s:
        return t
    m = NUM_DASH.match(s)
    if m and DASH_RE.search(s[m.end():]):
        return s[m.end():]
    return s


def read_text(path: Path) -> str:
    raw = path.read_bytes()
    for enc in ("utf-8-sig", "utf-16", "cp1251", "latin-1"):
        try:
            text = raw.decode(enc)
            if enc == "utf-16" and not raw[:2] in (b"\xff\xfe", b"\xfe\xff"):
                continue
            return text
        except UnicodeDecodeError:
            continue
    return raw.decode("utf-8", "replace")


def spotify_id(value: str):
    if not value:
        return None
    value = value.strip()
    m = SPOTIFY_ID_RE.search(value)
    if m:
        return m.group(1)
    if BARE_ID_RE.match(value):
        return value
    return None


def norm_header(h: str) -> str:
    return re.sub(r"\s+", " ", (h or "").strip().strip('"').lower().lstrip("\ufeff"))


def map_header(header):
    mapping = {}
    for idx, h in enumerate(header):
        nh = norm_header(h)
        for field, names in HEADER_MAP.items():
            if field not in mapping and nh in names:
                mapping[field] = idx
    return mapping


def try_csv(text: str):
    lines = [line for line in text.splitlines() if line.strip()]
    if len(lines) < 2:
        return None
    sample = "\n".join(lines[:20])
    try:
        dialect = csv.Sniffer().sniff(sample, delimiters=",;\t|")
    except csv.Error:
        return None
    rows = list(csv.reader(io.StringIO(text), dialect))
    rows = [r for r in rows if any(c.strip() for c in r)]
    if not rows:
        return None
    mapping = map_header(rows[0])
    if "title" not in mapping and "spotify" not in mapping:
        return None
    result = []
    for r in rows[1:]:
        def col(field):
            i = mapping.get(field)
            return r[i].strip() if i is not None and i < len(r) else ""
        row = {
            "title": col("title"), "artist": col("artist"), "album": col("album"),
            "isrc": col("isrc"), "sid": spotify_id(col("spotify")),
            "playlist": col("playlist"), "query": "",
        }
        if not row["sid"]:
            # иногда ссылка/URI лежит в другой колонке
            for cell in r:
                sid = spotify_id(cell) if "spotify" in cell else None
                if sid:
                    row["sid"] = sid
                    break
        if row["title"] or row["sid"]:
            result.append(row)
    return result


def parse_txt(text: str):
    result = []
    for line in text.splitlines():
        line = line.strip().lstrip("\ufeff")
        if not line or line.startswith("#"):
            continue
        line = strip_num(line)
        sid = spotify_id(line)
        if sid:
            result.append({"title": "", "artist": "", "album": "", "isrc": "", "sid": sid,
                           "playlist": "", "query": ""})
        elif re.match(r"^[a-z]+://", line):
            continue  # чужие ссылки не трогаем
        else:
            result.append({"title": "", "artist": "", "album": "", "isrc": "", "sid": None,
                           "playlist": "", "query": line})
    return result


def parse_dump(path: Path):
    text = read_text(path)
    rows = try_csv(text)
    kind = "csv"
    if rows is None:
        rows = parse_txt(text)
        kind = "txt"
    return rows, kind


def row_label(row):
    if row["title"]:
        return f"{row['artist']} - {row['title']}" if row["artist"] else row["title"]
    if row["query"]:
        return row["query"]
    return f"spotify:track:{row['sid']}"


def row_key(row):
    if row["sid"]:
        return "id:" + row["sid"]
    return "q:" + " ".join(sorted(tokens(row_label(row))))


# --------------------------------------------------------------------------
# Сопоставление с Spotify
# --------------------------------------------------------------------------
STOP = {"feat", "ft", "featuring", "with", "remastered", "remaster", "version", "the", "a",
        "and", "x", "vs", "prod", "official", "audio", "video", "lyrics"}


def tokens(s: str, drop_paren=False):
    s = unicodedata.normalize("NFKD", (s or "").lower())
    s = "".join(c for c in s if not unicodedata.combining(c))
    s = s.replace("ё", "е")
    if drop_paren:
        s = re.sub(r"[(\[].*?[)\]]", " ", s)
        s = re.split(r"\s[-–—]\s", s)[0]
    return {t for t in re.findall(r"\w+", s) if t not in STOP}


def cover(a, b):
    """Доля токенов a, найденных в b."""
    return len(a & b) / len(a) if a else 0.0


def score(item, row):
    name = item.get("name") or ""
    artists = " ".join(a.get("name", "") for a in item.get("artists") or [] if isinstance(a, dict))
    cand_t, cand_t_full, cand_a = tokens(name, True), tokens(name), tokens(artists)
    if row["title"]:
        rt, rt_full = tokens(row["title"], True), tokens(row["title"])
        t = max(cover(rt, cand_t_full), cover(cand_t, rt_full))
        if row["artist"]:
            ra = tokens(row["artist"])
            a = max(cover(ra, cand_a), cover(cand_a, ra))
            return (t + a) / 2 if t >= 0.6 and a >= 0.5 else 0.0
        return t if t >= 0.75 else 0.0
    q = tokens(row["query"])
    t = cover(cand_t, q)
    first_artist = tokens((item.get("artists") or [{}])[0].get("name", "")) if item.get("artists") else set()
    a = cover(first_artist, q) if first_artist else 0.0
    return (t + a) / 2 if t >= 0.7 and a >= 0.5 else 0.0


def build_query(row):
    if row["title"]:
        title = re.sub(r"\s*[(\[](feat|ft|with)[^)\]]*[)\]]", "", row["title"], flags=re.I)
        artist = re.split(r"[,;&]", row["artist"])[0] if row["artist"] else ""
        return f"{artist} {title}".strip()
    return re.sub(r"\s[-–—]\s", " ", row["query"])


def item_id(item):
    return item.get("id") or item.get("track_id") or spotify_id(item.get("uri", "") or "")


class Spotify:
    def __init__(self):
        self.client = None
        self.song_fields = None
        try:
            from spotdl.utils.spotify import SpotifyClient  # type: ignore
            from spotdl.utils.config import SPOTIFY_OPTIONS  # type: ignore
            try:
                from spotdl.types.song import Song  # type: ignore
                self.song_fields = list(Song.__dataclass_fields__)  # pylint: disable=no-member
            except Exception:  # noqa: BLE001
                pass
            SpotifyClient.init(client_id=SPOTIFY_OPTIONS["client_id"],
                               client_secret=SPOTIFY_OPTIONS["client_secret"])
            self.client = SpotifyClient()
        except ImportError:
            warn("spotDL не найден — все треки будут скачаны с YouTube.")
        except Exception as e:  # noqa: BLE001
            warn(f"Не удалось подключиться к Spotify ({e}) — качаю с YouTube.")

    def search(self, query):
        if not self.client:
            return None
        for attempt in range(4):
            try:
                res = self.client.search(query, type="track")
                return ((res or {}).get("tracks") or {}).get("items") or []
            except Exception as e:  # noqa: BLE001
                wait = 5 * (attempt + 1) ** 2
                if attempt < 3:
                    warn(f"Spotify: {str(e)[:80]} — повтор через {wait} с")
                    time.sleep(wait)
        return None


def song_from_item(item):
    """Полные метаданные трека для spotDL из ответа Spotify (поиск или track()).

    Если передать их spotDL, он не делает reinit_song — а это 3 запроса к Spotify
    на КАЖДЫЙ трек (track + artist + album), главная причина медленной загрузки.
    None — если данных не хватает (тогда spotDL догрузит их сам).
    """
    try:
        alb = item.get("album") or {}
        artists = [a.get("name") for a in item.get("artists") or [] if isinstance(a, dict) and a.get("name")]
        sid = item_id(item)
        dur = int((item.get("duration_ms") or 0) / 1000)
        date = str(alb.get("release_date") or "")
        # бесплатный клиент иногда отдаёт «0000-00-00» — spotDL в этом случае сам ставит год 0
        year = int(date[:4]) if re.match(r"^\d{4}", date) else 0
        if not (isinstance(alb, dict) and alb.get("id") and artists and item.get("name") and sid and dur > 0):
            return None
        imgs = [i for i in alb.get("images") or [] if isinstance(i, dict) and i.get("url")]
        cover_url = max(imgs, key=lambda i: (i.get("width") or 0) * (i.get("height") or 0))["url"] if imgs else None
        alb_artists = [a.get("name") for a in alb.get("artists") or [] if isinstance(a, dict) and a.get("name")]
        tn = int(item.get("track_number") or 1)
        dn = int(item.get("disc_number") or 1)
        return {
            "name": item["name"], "artists": artists, "artist": artists[0],
            "artist_id": (item["artists"][0] or {}).get("id") or None,
            # числа дисков в ответе track() нет (spotDL берёт его из треклиста альбома):
            # номер текущего диска — точная нижняя граница, для 1-дискового альбома (почти всегда) = 1
            "genres": [], "disc_number": dn, "disc_count": dn,
            "album_name": alb.get("name") or "", "album_artist": (alb_artists or artists)[0],
            "album_id": alb["id"], "album_type": alb.get("album_type"),
            "duration": dur, "year": year, "date": date,
            "track_number": tn, "tracks_count": max(int(alb.get("total_tracks") or 0), tn),
            "song_id": sid, "explicit": bool(item.get("explicit")), "publisher": "",
            "url": f"https://open.spotify.com/track/{sid}",
            "isrc": (item.get("external_ids") or {}).get("isrc") or None,
            "cover_url": cover_url, "copyright_text": None, "popularity": item.get("popularity"),
        }
    except Exception:  # noqa: BLE001
        return None


def resolve(rows, sp: Spotify, cache: dict, save_cache):
    """Ищет треки без Spotify ID: cache[key] = spotify_id | '' ('' — нет в Spotify)."""
    # '' (не найдено) ищем заново: это могла быть временная ошибка/лимит Spotify
    todo = [r for r in rows if not r["sid"] and not cache.get(row_key(r))]
    if not todo or not sp.client:
        return
    say(f"Ищу в Spotify {len(todo)} трек(ов)…")
    done = 0

    def work(row):
        isrc = (row.get("isrc") or "").strip().upper()
        if re.match(r"^[A-Z]{2}[A-Z0-9]{3}\d{7}$", isrc):  # точное совпадение записи
            for item in sp.search(f"isrc:{isrc}") or []:
                if ((item.get("external_ids") or {}).get("isrc") or "").upper() == isrc or score(item, row):
                    return row, item_id(item), song_from_item(item)
        items = sp.search(build_query(row))
        if items is None:
            return row, None, None
        best, best_score = None, 0.0
        for item in items[:8]:
            s = score(item, row)
            if s > best_score:
                best, best_score = item, s
        meta = song_from_item(best) if best else None
        return row, (item_id(best) if best else ""), meta

    with ThreadPoolExecutor(max_workers=4) as ex:
        for row, sid, meta in ex.map(work, todo):
            done += 1
            label = row_label(row)
            if sid is None:
                print(f"  [{done}/{len(todo)}] {C_WARN}? ошибка поиска{C_0} {label}", flush=True)
                continue
            cache[row_key(row)] = sid
            if sid and meta:
                cache.setdefault("meta", {})[sid] = meta
            mark = f"{C_OK}✔{C_0}" if sid else f"{C_WARN}→ YouTube{C_0}"
            print(f"  [{done}/{len(todo)}] {mark} {label}", flush=True)
            if done % 25 == 0:
                save_cache()
    save_cache()


def fetch_meta(sids, sp: Spotify, cache: dict, save_cache):
    """Метаданные для треков, у которых есть только Spotify ID: 1 запрос вместо 3 у spotDL,
    параллельно и с сохранением в кэш (при повторном запуске — ни одного запроса)."""
    meta = cache.setdefault("meta", {})
    todo = [s for s in dict.fromkeys(sids) if s and s not in meta]
    if not todo or not sp or not sp.client or not hasattr(sp.client, "track"):
        return
    say(f"Получаю данные о {len(todo)} трек(ах) из Spotify…")
    done = 0

    def work(sid):
        for attempt in range(3):
            try:
                return sid, song_from_item(sp.client.track(sid))
            except Exception:  # noqa: BLE001
                time.sleep(3 * (attempt + 1))
        return sid, None

    with ThreadPoolExecutor(max_workers=4) as ex:
        for sid, m in ex.map(work, todo):
            done += 1
            if m:
                meta[sid] = m
            if done % 25 == 0 or done == len(todo):
                print(f"  {done}/{len(todo)}", flush=True)
                save_cache()


# --------------------------------------------------------------------------
# Проверка уже скачанного
# --------------------------------------------------------------------------
AUDIO_EXT = {".mp3", ".m4a", ".opus", ".ogg", ".flac", ".wav", ".aac", ".webm"}
FEAT_RE = re.compile(r"\s*[(\[](?:feat|ft|with)\b[^)\]]*[)\]]", re.I)


def title_sig(title):
    return frozenset(tokens(FEAT_RE.sub(" ", title or "")))


def first_artist(artists):
    return tokens(re.split(r"[,;&]", artists or "")[0])


def compact(s):
    """Только буквы и цифры: «AC/DC» и «ACDC», «Intro/Chamber» и «IntroChamber», «S**t» и «St»
    совпадают. spotDL просто выбрасывает из имён файлов символы /?\\*|<>, а мы — заменяем на «_»."""
    s = unicodedata.normalize("NFKD", (s or "").lower())
    s = "".join(c for c in s if not unicodedata.combining(c)).replace("ё", "е")
    return re.sub(r"[\W_]+", "", s)


def row_parts(row, cache):
    """(название, исполнители) строки дампа — для сравнения с именами файлов."""
    if row["title"]:
        return row["title"], row["artist"]
    if row["query"]:
        parts = DASH_RE.split(row["query"], maxsplit=1)
        return (parts[1], parts[0]) if len(parts) == 2 else (row["query"], "")
    sid = row["sid"] or cache.get(row_key(row))
    m = (cache.get("meta") or {}).get(sid) if sid else None
    if m:
        return m.get("name") or "", m.get("artist") or ""
    return None


class Existing:
    """Аудиофайлы в папке плейлиста: один проход по папке, поиск за O(1)."""

    def __init__(self, dest: Path):
        self.names, self.index, self.cindex = set(), {}, {}
        try:
            files = [p for p in dest.iterdir() if p.suffix.lower() in AUDIO_EXT and p.is_file()]
        except OSError:
            files = []
        for p in files:
            self.names.add(p.name)
            parts = DASH_RE.split(strip_num(p.stem), maxsplit=1)
            artist, title = (parts[0], parts[1]) if len(parts) == 2 else ("", parts[0])
            self.index.setdefault(title_sig(title), []).append((tokens(artist), p.name))
            self.cindex.setdefault(compact(FEAT_RE.sub(" ", title)), []).append((compact(artist), p.name))

    def find(self, row, cache):
        known = (cache.get("files") or {}).get(row_key(row))
        if known and known in self.names:
            return known
        parts = row_parts(row, cache)
        if not parts:
            return None
        title, artists = parts
        t, a = title_sig(title), first_artist(artists)
        if t:
            for file_artists, name in self.index.get(t, []):
                # название совпадает полностью (ремикс/live — другое название), исполнитель — входит
                if not a or not file_artists or a <= file_artists or cover(a, file_artists) >= 0.5:
                    return name
        # запасной вариант — сравнение «только буквы и цифры»: спецсимволы в названии/исполнителе
        # (AC/DC, Skumf*k) или название из одних «стоп-слов» (System Of A Down — «X»)
        ct = compact(FEAT_RE.sub(" ", title))
        ca = compact(re.split(r"[,;&]", artists or "")[0])
        if not ct:
            return None
        for file_ca, name in self.cindex.get(ct, []):
            if ca and file_ca and (ca in file_ca or file_ca in ca):
                return name
            if len(ct) >= 4 and (not ca or not file_ca):  # короткое название без исполнителя — не угадываем
                return name
        return None


# --------------------------------------------------------------------------
# Загрузка
# --------------------------------------------------------------------------
def safe_name(s: str, limit=120) -> str:
    """limit — в БАЙТАХ UTF-8: лимит имени файла 255 байт, а кириллица/эмодзи — 2–4 байта на символ."""
    s = re.sub(r'[\\/:*?"<>|{}\x00-\x1f]', "_", s).strip(" .") or "playlist"
    b = s.encode("utf-8")
    if len(b) > limit:
        s = b[:limit].decode("utf-8", "ignore").rstrip(" .") or "playlist"
    return s


def js_runtime_args(install=True):
    """YouTube требует JS-движок; Deno под Android не работает — всегда используем Node.js."""
    if install and not shutil.which("node") and shutil.which("pkg"):
        say("Устанавливаю Node.js (нужен для YouTube)…")
        subprocess.call(["pkg", "install", "-y", "nodejs-lts"])
    return ["--js-runtimes", "node"] if shutil.which("node") else []


def spotdl_cmd():
    exe = shutil.which("spotdl")
    return [exe] if exe else [sys.executable, "-m", "spotdl"]


def run_spotdl(entries, dest: Path, opts, dry: bool):
    tmpl = "{list-position} - {artists} - {title}.{output-ext}" if opts.numbered else "{artists} - {title}.{output-ext}"
    spotdl_file = dest / f".playlist-{PID}.spotdl"
    cmd = spotdl_cmd() + ["download", str(spotdl_file), "--output", tmpl,
                          "--threads", str(opts.threads), "--format", opts.format,
                          "--save-errors", ".spotdl-errors.txt"]
    if opts.format in ("m4a", "opus"):
        cmd += ["--bitrate", "disable"]  # без перекодирования: файл YouTube просто копируется
    if opts.no_lyrics:
        cmd += ["--lyrics"]  # пустой список = не искать тексты
    js = js_runtime_args(install=not dry)
    if js:
        cmd += ["--yt-dlp-args", " ".join(js)]
    full = sum(1 for e in entries if e.get("name"))
    say(f"spotDL: скачиваю {len(entries)} трек(ов), до {min(opts.threads, len(entries))} одновременно…")
    if js:
        print("  (предупреждение spotDL «Some YouTube downloads require Deno» можно игнорировать —"
              " используется Node.js)")
    if full < len(entries):
        print(f"  (для {len(entries) - full} трек(ов) spotDL сам догрузит данные из Spotify — это дольше)")
    if dry:
        print("[dry-run]", " ".join(cmd))
        return 0
    try:
        spotdl_file.write_text(json.dumps(entries, ensure_ascii=False), encoding="utf-8")
    except OSError as e:
        err(f"Не удалось записать список для spotDL: {e}")
        return 1
    try:
        return subprocess.call(cmd, cwd=str(dest))
    finally:
        spotdl_file.unlink(missing_ok=True)


def youtube_cookies():
    for name in ("youtube_music.txt", "youtube.txt", "cookies.txt"):
        f = COOKIES_DIR / name
        if f.is_file():
            return ["--cookies", str(f)]
    return []


def run_youtube(rows, dest: Path, opts, dry: bool, positions=None, total=0):
    """Запасной вариант: поиск на YouTube, несколько треков параллельно.
    Возвращает {row_key: имя файла} для скачанных."""
    if not rows:
        return {}
    ytdlp = shutil.which("yt-dlp")
    if not ytdlp and not dry:
        say("Устанавливаю yt-dlp…")
        subprocess.call([sys.executable, "-m", "pip", "install", "-U", "yt-dlp[default]"])
        ytdlp = shutil.which("yt-dlp")
    cmd_base = ([ytdlp] if ytdlp else [sys.executable, "-m", "yt_dlp"]) + js_runtime_args(install=not dry)
    cmd_base += youtube_cookies()  # те же cookies, что у termux-url-opener (18+, «подтвердите, что вы не бот»)
    fmt = opts.format
    if fmt == "m4a":
        audio = ["-f", "bestaudio[ext=m4a]/bestaudio/best", "-x", "--audio-format", "m4a"]
    elif fmt == "opus":
        audio = ["-f", "bestaudio[acodec=opus]/bestaudio/best", "-x", "--audio-format", "opus"]
    else:
        audio = ["-x", "--audio-format", "mp3", "--audio-quality", "0"]
    workers = max(1, min(opts.threads, 4, len(rows)))
    say(f"YouTube: скачиваю {len(rows)} трек(ов), {workers} одновременно…")
    count, done, got, failed = len(rows), 0, {}, []
    width = len(str(total or count))

    def work(row):
        label = row_label(row)
        base = safe_name(label, 180)  # байты; + расширение и временные суффиксы yt-dlp < 255
        if opts.numbered and positions:
            base = f"{str(positions.get(row_key(row), 0)).zfill(width)} - {base}"
        target = dest / f"{base}.{fmt}"
        if target.exists():
            return row, label, target.name
        # из 3 результатов берём первый не длиннее 15 минут и не стрим —
        # чтобы не скачать часовой микс или трансляцию вместо трека
        cmd = cmd_base + ["-q", "--no-warnings", "--no-progress", "--no-playlist", *audio,
                          "--embed-thumbnail", "--embed-metadata", "--windows-filenames",
                          "--match-filter", "duration<=?900 & !is_live", "--max-downloads", "1",
                          "--print", "after_move:filepath",  # реальное имя файла после конвертации
                          "-o", str(dest / f"{base}.%(ext)s"), f"ytsearch3:{label}"]
        if dry:
            print("[dry-run]", " ".join(cmd))
            return row, label, None
        # код 101 = «достигнут --max-downloads» — это успех, поэтому смотрим на результат, а не на код
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        for line in reversed((res.stdout or "").splitlines()):
            f = Path(line.strip())
            if line.strip() and f.is_file():
                return row, label, f.name, ""
        if target.exists():
            return row, label, target.name, ""
        err_lines = [ln.strip() for ln in (res.stderr or "").splitlines() if ln.strip()]
        reason = re.sub(r"^ERROR:\s*", "", err_lines[-1])[:120] if err_lines else ""
        return row, label, None, reason

    with ThreadPoolExecutor(max_workers=workers) as ex:
        for row, label, fname, reason in ex.map(work, rows):
            done += 1
            if fname:
                got[row_key(row)] = fname
                print(f"  [{done}/{count}] {C_OK}✔{C_0} {label}", flush=True)
            elif not dry:
                failed.append(label)
                suffix = f" ({reason})" if reason else ""
                print(f"  [{done}/{count}] {C_ERR}✘{C_0} {label}{suffix}", flush=True)
    if failed:
        try:
            with open(dest / ".not-found.txt", "a", encoding="utf-8") as f:
                f.write("\n".join(failed) + "\n")
        except OSError:
            pass
        warn(f"Не скачано: {len(failed)} (список: {dest.name}/.not-found.txt)")
    return got


def entry_for(sid, name, pos, total, fields, meta=None, isrc=None):
    fields = fields or [
        "name", "artists", "artist", "genres", "disc_number", "disc_count", "album_name",
        "album_artist", "duration", "year", "date", "track_number", "tracks_count", "song_id",
        "explicit", "publisher", "url", "isrc", "cover_url", "copyright_text"]
    e = {f: None for f in fields}
    if meta:
        e.update({k: v for k, v in meta.items() if k in e})
        if isrc and not e.get("isrc"):
            e["isrc"] = isrc  # ISRC из дампа помогает spotDL найти точную запись
    e.update({"url": f"https://open.spotify.com/track/{sid}", "song_id": sid,
              "list_name": name, "list_position": pos, "list_length": total})
    return {k: v for k, v in e.items() if k in fields or k.startswith("list_")}


def wake(lock: bool):
    exe = shutil.which("termux-wake-lock" if lock else "termux-wake-unlock")
    if exe:
        subprocess.call([exe], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ask(prompt, default=True):
    if not sys.stdin.isatty():
        return default
    try:
        ans = input(prompt).strip().lower()
    except EOFError:
        return default
    if not ans:
        return default
    return ans[0] in ("y", "д", "1")


def pick_file():
    files = []
    for d in SEARCH_DIRS:
        if d.is_dir():
            files += [p for p in d.iterdir() if p.is_file() and p.suffix.lower() in (".csv", ".txt")]
    files = sorted(set(files), key=lambda p: p.stat().st_mtime, reverse=True)[:20]
    if not files:
        err("Не нашёл .csv/.txt в Download. Укажите путь: playlist-dump /путь/к/файлу.csv")
        return []
    print(f"{C_B}Файлы плейлистов:{C_0}")
    for i, p in enumerate(files, 1):
        print(f"  {i:2}) {p.name}   {C_INF}({p.parent.name}){C_0}")
    try:
        ans = input("Номер(а) через пробел: ").split()
    except EOFError:
        return []
    return [files[int(a) - 1] for a in ans if a.isdigit() and 0 < int(a) <= len(files)]


def load_cache(dest: Path, dry=False):
    cache_file = dest / CACHE_NAME
    try:
        cache = json.loads(cache_file.read_text(encoding="utf-8"))
        if not isinstance(cache, dict):
            cache = {}
    except Exception:  # noqa: BLE001
        cache = {}

    def save_cache():
        if dry:
            return
        tmp = cache_file.with_name(f"{CACHE_NAME}.{PID}.tmp")
        try:
            tmp.write_text(json.dumps(cache, ensure_ascii=False), encoding="utf-8")
            tmp.replace(cache_file)
        except OSError:
            tmp.unlink(missing_ok=True)
    return cache, save_cache


def write_m3u(dest: Path, name: str, grows, cache):
    """Плейлист в порядке дампа — из всех скачанных треков, а не только из новых."""
    files = cache.get("files") or {}
    lines, seen = ["#EXTM3U"], set()
    for r in grows:
        f = files.get(row_key(r))
        if f and f not in seen and (dest / f).exists():
            seen.add(f)
            lines.append(f)
    if len(lines) > 1:
        try:
            (dest / f"{safe_name(name)}.m3u8").write_text("\n".join(lines) + "\n", encoding="utf-8")
        except OSError as e:
            warn(f"Не удалось записать плейлист .m3u8: {e}")


def lock_dir(dest: Path):
    """(можно ли продолжать, дескриптор). Два окна Termux не качают одну папку одновременно."""
    try:
        import fcntl  # noqa: PLC0415
        fh = open(dest / ".playlist-dump.lock", "a", encoding="utf-8")  # noqa: SIM115
    except (ImportError, OSError):
        return True, None
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as e:
        if e.errno in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
            fh.close()
            return False, None
        return True, fh  # файловая система без блокировок — работаем без неё
    return True, fh


def shown(dest: Path) -> str:
    try:
        return f"{ROOT.name}/{dest.relative_to(ROOT)}"
    except ValueError:
        return str(dest)


class Group:
    """Плейлист из дампа + что из него уже лежит в папке."""

    def __init__(self, name, rows, dest: Path, dry=False):
        self.name, self.rows, self.dest = name, rows, dest
        self.cache, self.save_cache = load_cache(self.dest, dry)
        self.refresh()

    def refresh(self):
        """Сверка дампа с папкой — без единого сетевого запроса."""
        ex = Existing(self.dest)
        files = self.cache.setdefault("files", {})
        self.missing, seen, self.have = [], set(), 0
        for r in self.rows:
            key = row_key(r)
            f = ex.find(r, self.cache)
            if f:
                files[key] = f
                self.have += 1
            elif key not in seen:  # дубли в дампе качаем один раз
                seen.add(key)
                self.missing.append(r)


def preview(rows, title, extra=""):
    with_id = sum(1 for r in rows if r["sid"])
    print(f"\n{C_B}━━━ {title} ━━━{C_0}")
    print(f"Треков: {len(rows)}" + (f"  (со Spotify ID: {with_id})" if with_id else "") + extra)
    for r in rows[:5]:
        print(f"   • {row_label(r)}")
    if len(rows) > 5:
        print(f"   … и ещё {len(rows) - 5}")


def process_group(g: Group, sp, args, m3u=True):
    """Скачать недостающее для одной группы. True — всё на месте."""
    dest, cache, save_cache = g.dest, g.cache, g.save_cache
    fh = None
    if not args.dry_run:
        try:
            dest.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            err(f"Не удалось создать папку {shown(dest)}: {e}")
            return False
        can, fh = lock_dir(dest)
        if not can:
            err(f"{g.name}: эта папка уже скачивается в другом окне Termux — дождитесь окончания.")
            return False
    try:
        print(f"\n{C_B}▶ {g.name}{C_0}  →  {shown(dest)}/  ({len(g.missing)} из {len(g.rows)})")

        # 2. Сеть — только для недостающих треков (в --dry-run сети нет вообще)
        spotify_ok = bool(sp and sp.client) and not args.yt_only
        if spotify_ok:
            resolve(g.missing, sp, cache, save_cache)
            fetch_meta([r["sid"] or cache.get(row_key(r)) for r in g.missing], sp, cache, save_cache)
            # после получения названий по ID могли найтись уже скачанные файлы
            g.refresh()
        elif args.dry_run and not args.yt_only:
            n = sum(1 for r in g.missing if not r["sid"] and not cache.get(row_key(r)))
            if n:
                print(f"[dry-run] поиск в Spotify пропущен: {n} трек(ов) без Spotify ID показаны как YouTube")
        use_spotify = spotify_ok or (args.dry_run and not args.yt_only)

        positions = {}
        for pos, r in enumerate(g.rows, 1):
            positions.setdefault(row_key(r), pos)
        meta = cache.get("meta") or {}
        fields = sp.song_fields if sp else None
        entries, yt_rows, no_meta = [], [], []
        for r in g.missing:
            sid = r["sid"] or (cache.get(row_key(r)) if use_spotify else None)
            if sid and use_spotify:
                entries.append(entry_for(sid, g.name, positions[row_key(r)], len(g.rows),
                                         fields, meta.get(sid), r["isrc"] or None))
            elif r["sid"] and not r["title"] and not r["query"]:
                no_meta.append(f"https://open.spotify.com/track/{r['sid']}")
            else:
                yt_rows.append(r)

        if not args.dry_run:
            (dest / ".not-found.txt").unlink(missing_ok=True)  # список прошлого запуска
        if no_meta:
            warn(f"{len(no_meta)} трек(ов) заданы только ссылкой Spotify без названия — "
                 "без spotDL их не найти, пропущены.")
            if not args.dry_run:
                try:
                    with open(dest / ".not-found.txt", "a", encoding="utf-8") as f:
                        f.write("\n".join(no_meta) + "\n")
                except OSError:
                    pass
        if entries:
            run_spotdl(entries, dest, args, args.dry_run)
            if not args.dry_run:
                # что spotDL не смог (LookupError «No results found», ошибка YT-DLP) — вторая попытка:
                # прямой поиск на YouTube, он находит другие видео
                g.refresh()
                planned = {row_key(r) for r in yt_rows}
                retry = [with_title(r, cache) for r in g.missing if row_key(r) not in planned]
                retry = [r for r in retry if r["title"] or r["query"]]
                if retry:
                    say(f"spotDL не скачал {len(retry)} трек(ов) — ищу их на YouTube напрямую…")
                    yt_rows = yt_rows + retry
        got = run_youtube(yt_rows, dest, args, args.dry_run, positions, len(g.rows))

        if args.dry_run:
            return True
        cache.setdefault("files", {}).update(got)
        g.refresh()  # запомнить, какой файл соответствует какой строке дампа
        if m3u:
            write_m3u(dest, g.name, g.rows, cache)
        save_cache()
        if g.missing:
            warn(f"{g.name}: не скачано {len(g.missing)} — запустите ещё раз, скачанное будет пропущено.")
            return False
        ok(f"Готово: {g.name}")
        return True
    finally:
        if fh:
            fh.close()


def with_title(row, cache):
    """Строка только со Spotify ID → копия с названием из кэша метаданных (для поиска на YouTube)."""
    if row["title"] or row["query"]:
        return row
    sid = row["sid"] or cache.get(row_key(row))
    m = (cache.get("meta") or {}).get(sid) if sid else None
    if not m:
        return row
    return {**row, "title": m.get("name") or "", "artist": ", ".join(m.get("artists") or [m.get("artist") or ""])}


def fetch_groups(groups, rows, args, state, m3u=True):
    """Общая часть для дампов и ссылок. Возвращает 'ok' | 'error' | 'cancel'."""
    # 1. В первую очередь — что уже скачано (только локальная проверка)
    todo = sum(len(g.missing) for g in groups)
    have = sum(g.have for g in groups)
    if have:
        ok(f"Уже скачано: {have} из {len(rows)}")
    if args.check:
        for g in groups:
            if g.missing and len(groups) > 1:
                print(f"   {g.name}: не хватает {len(g.missing)}")
        if todo:
            print(f"Осталось скачать: {todo}")
        return "ok"
    if not todo:
        for g in groups:
            if not args.dry_run:
                if m3u:
                    write_m3u(g.dest, g.name, g.rows, g.cache)
                g.save_cache()
        ok("Все треки уже скачаны — нечего делать.")
        return "ok"

    # и для TXT, и для CSV: файл с колонкой «Name» (контакты, таблица) — ещё не список треков
    liked = sum(1 for r in rows if r["sid"] or (r["title"] and r["artist"]) or DASH_RE.search(r["query"] or ""))
    default_yes = liked >= len(rows) / 2
    if not default_yes:
        warn("Похоже, это не список треков (мало строк вида «Исполнитель - Название»).")
    hint = "[Y/n]" if default_yes else "[y/N]"
    what = f"{todo} новых трек(ов)" if have else f"{todo} трек(ов)"
    if not args.yes and not ask(f"Скачать {what}? {hint} ", default=default_yes):
        warn("Отменено")
        return "cancel"

    if state.get("sp") is None and not args.yt_only and not args.dry_run:
        state["sp"] = Spotify()
    sp = state.get("sp")
    failed = False
    wake(True)
    try:
        for g in groups:
            if g.missing and not process_group(g, sp, args, m3u):
                failed = True
    finally:
        wake(False)
    return "error" if failed else "ok"


def download(paths, args):
    """Код возврата: 0 — всё скачано, 1 — были ошибки, 2 — всё отменено."""
    state, had_error, cancelled, done_any = {}, False, False, False
    for path in paths:
        path = Path(path).expanduser()  # «~/…» в кавычках shell не раскрывает
        if not path.is_file():
            err(f"Файл не найден: {path}")
            had_error = True
            continue
        try:
            rows, kind = parse_dump(path)
        except OSError as e:
            err(f"Не удалось прочитать {path.name}: {e}")
            had_error = True
            continue
        if not rows:
            err(f"В файле не найдено треков: {path.name}")
            had_error = True
            continue
        grouped = {}
        for r in rows:
            grouped.setdefault(args.name or r["playlist"] or path.stem, []).append(r)
        preview(rows, f"{path.name} ({kind.upper()})", f"  плейлистов: {len(grouped)}")

        groups = [Group(n, g, ROOT / "Spotify" / safe_name(n), args.dry_run) for n, g in grouped.items()]
        res = fetch_groups(groups, rows, args, state)
        if res == "cancel":
            cancelled = True
            continue
        if res == "error":
            had_error = True
        else:
            done_any = True

        # сохранить сам дамп рядом с остальными выгрузками
        if args.keep_dump and not args.check and not args.dry_run and path.parent == HOME / "downloads":
            keep = ROOT / "Playlists"
            try:
                keep.mkdir(parents=True, exist_ok=True)
                target = keep / path.name
                if target.exists():
                    target = keep / f"{path.stem}_{time.strftime('%Y%m%d-%H%M%S')}{path.suffix}"
                shutil.move(str(path), str(target))
            except OSError as e:
                warn(f"Не удалось перенести дамп в {shown(keep)}: {e}")
    if had_error:
        return 1
    return 2 if cancelled and not done_any else 0


# --------------------------------------------------------------------------
# Ссылки Deezer / Apple Music (DRM не трогаем: берём только список треков
# из открытых API и качаем те же треки через Spotify/YouTube).
# Публичный API song.link (Odesli) закрыт 31.07.2026 — он больше не используется.
# --------------------------------------------------------------------------
class LinkError(Exception):
    pass


class _HttpOnlyRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not re.match(r"^https?://", newurl or "", re.I):
            raise LinkError(f"Небезопасный редирект: {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_HTTP_OPENER = urllib.request.build_opener(_HttpOnlyRedirect)


def http_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with _HTTP_OPENER.open(req, timeout=20) as r:  # noqa: S310 — только https-адреса API ниже
        return json.loads(r.read().decode("utf-8", "replace"))


def final_url(url):
    """Короткие ссылки Deezer (link.deezer.com/s/…, deezer.page.link) → полная ссылка."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with _HTTP_OPENER.open(req, timeout=15) as r:  # noqa: S310
            res = r.geturl()
            return res if re.match(r"^https?://", res or "", re.I) else url
    except Exception:  # noqa: BLE001
        return url


def mk_row(title, artist, album="", isrc=""):
    return {"title": (title or "").strip(), "artist": (artist or "").strip(), "album": album or "",
            "isrc": isrc or "", "sid": None, "playlist": "", "query": ""}


def deezer_checked(d):
    if not isinstance(d, dict):
        raise LinkError("Deezer вернул неожиданный ответ")
    if "error" in d:
        e = d["error"] if isinstance(d["error"], dict) else {}
        raise LinkError(f"Deezer: {e.get('message') or 'ошибка'} (закрытый или удалённый плейлист?)")
    return d


def deezer_artist(t):
    names = [c.get("name") for c in t.get("contributors") or [] if isinstance(c, dict) and c.get("name")]
    return ", ".join(names) if names else (t.get("artist") or {}).get("name", "")


def deezer_pages(url, limit=5000):
    items = []
    while url and len(items) < limit:
        d = deezer_checked(http_json(url))
        items += [t for t in d.get("data") or [] if isinstance(t, dict) and t.get("title")]
        url = d.get("next")
    return items


def resolve_deezer(kind, did):
    api = "https://api.deezer.com"
    if kind == "track":
        t = deezer_checked(http_json(f"{api}/track/{did}"))
        return None, [mk_row(t.get("title"), deezer_artist(t), (t.get("album") or {}).get("title"), t.get("isrc"))]
    if kind == "album":
        a = deezer_checked(http_json(f"{api}/album/{did}"))
        name = f"{(a.get('artist') or {}).get('name', '')} - {a.get('title', did)}".strip(" -")
        tracks = deezer_pages(f"{api}/album/{did}/tracks?limit=500")
        return name, [mk_row(t["title"], deezer_artist(t), a.get("title"), t.get("isrc")) for t in tracks]
    p = deezer_checked(http_json(f"{api}/playlist/{did}"))
    tracks = deezer_pages(f"{api}/playlist/{did}/tracks?limit=500")
    return p.get("title") or f"Deezer {did}", [
        mk_row(t["title"], deezer_artist(t), (t.get("album") or {}).get("title"), t.get("isrc")) for t in tracks]


def resolve_apple(url):
    u = urllib.parse.urlparse(url)
    parts = [p for p in u.path.split("/") if p]
    cc = "us"
    if parts and re.fullmatch(r"[a-z]{2}", parts[0]):
        cc, parts = parts[0], parts[1:]
    kind = parts[0] if parts else ""
    last = re.sub(r"^id(?=\d)", "", parts[-1]) if parts else ""
    if kind == "playlist" or last.startswith("pl."):
        raise LinkError("playlist")
    tid = (urllib.parse.parse_qs(u.query).get("i") or [None])[0] or (last if kind == "song" else None)
    look = "https://itunes.apple.com/lookup?country=" + urllib.parse.quote(cc)
    if tid and str(tid).isdigit():
        res = http_json(f"{look}&id={tid}").get("results") or []
        tr = [x for x in res if x.get("wrapperType") == "track" and x.get("trackName")]
        if not tr:
            raise LinkError("Трек не найден в каталоге Apple (iTunes Search API)")
        t = tr[0]
        return None, [mk_row(t["trackName"], t.get("artistName"), t.get("collectionName"))]
    if kind == "album" and last.isdigit():
        res = http_json(f"{look}&id={last}&entity=song&limit=200").get("results") or []
        coll = next((x for x in res if x.get("wrapperType") == "collection"), {})
        tr = sorted((x for x in res if x.get("wrapperType") == "track" and x.get("trackName")),
                    key=lambda x: (x.get("discNumber") or 1, x.get("trackNumber") or 0))
        if not tr:
            raise LinkError("Альбом не найден в каталоге Apple (iTunes Search API)")
        if len(tr) >= 200:
            warn("iTunes API возвращает не более 200 треков альбома — список может быть неполным.")
        name = f"{coll.get('artistName') or tr[0].get('artistName', '')} - {coll.get('collectionName') or tr[0].get('collectionName', '')}"
        return name.strip(" -"), [mk_row(t["trackName"], t.get("artistName"), t.get("collectionName")) for t in tr]
    raise LinkError(None)


DEEZER_RE = re.compile(r"deezer\.com/(?:[a-z]{2}(?:-[a-z]{2})?/)?(track|album|playlist)/(\d+)")


def resolve_link(url):
    """(имя альбома/плейлиста или None для трека, строки). LinkError(None) — сервис не поддерживается."""
    host = urllib.parse.urlparse(url).netloc.lower()
    if host in ("link.deezer.com", "deezer.page.link", "dzr.page.link"):
        url = final_url(url)
    m = DEEZER_RE.search(url)
    if m:
        return resolve_deezer(m.group(1), m.group(2))
    if re.search(r"(^|\.)(music|itunes|geo\.music)\.apple\.com$", urllib.parse.urlparse(url).netloc.lower()):
        return resolve_apple(url)
    raise LinkError(None)


def guess_service(url):
    host = urllib.parse.urlparse(url).netloc.lower()
    for key, name in (("deezer", "Deezer"), ("apple", "Apple Music"), ("tidal", "Tidal"),
                      ("amazon", "Amazon Music"), ("yandex", "Yandex Music")):
        if key in host:
            return name
    return "Music"


def link_unsupported(url, dry):
    path = urllib.parse.urlparse(url).path
    if "/playlist" in path or "/pl." in path:
        err("Плейлисты этого сервиса без входа в аккаунт не получить.")
        warn("Перенесите плейлист в Spotify (tunemymusic.com / soundiiz.com) и поделитесь ссылкой Spotify,")
        warn("или выгрузите его там в CSV и поделитесь файлом в Termux.")
        return
    page = "https://song.link/" + url
    err("Для этого сервиса нет открытого API (публичный API song.link закрыт с 31.07.2026).")
    warn("Откройте страницу song.link, выберите Spotify или YouTube Music и поделитесь той ссылкой в Termux:")
    print("  " + page)
    if not dry and shutil.which("termux-open-url"):
        subprocess.call(["termux-open-url", page], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def link(url, args):
    url = url.strip()
    if not re.match(r"^https?://", url):
        err(f"Это не ссылка: {url}")
        return 1
    service = safe_name(args.service or guess_service(url), 60)
    if args.dry_run:
        print(f"[dry-run] данные о треках берутся из API Deezer/iTunes: {url}")
    try:
        name, rows = resolve_link(url)
    except LinkError as e:
        if e.args and e.args[0] and e.args[0] != "playlist":
            err(str(e.args[0]))
            return 1
        link_unsupported(url, args.dry_run)
        return 1
    except Exception as e:  # noqa: BLE001 — сеть, JSON, неожиданный формат ответа
        err(f"Не удалось получить список треков: {e}")
        return 1
    rows = [r for r in rows if r["title"]]
    if not rows:
        err("Список треков пуст.")
        return 1
    if args.name:
        name = args.name
    title = f"{service}: {name}" if name else f"{service}: {row_label(rows[0])}"
    preview(rows, title)
    # альбом/плейлист — в свою подпапку с .m3u8, одиночный трек — прямо в папку сервиса
    dest = ROOT / service / safe_name(name) if name else ROOT / service
    group = Group(name or service, rows, dest, args.dry_run)
    res = fetch_groups([group], rows, args, {}, m3u=bool(name))
    return {"ok": 0, "error": 1, "cancel": 2}[res]


# --------------------------------------------------------------------------
# Выгрузка (export)
# --------------------------------------------------------------------------
def export(urls, fmt):
    try:
        from spotdl.utils.spotify import SpotifyClient  # type: ignore
        from spotdl.utils.config import SPOTIFY_OPTIONS  # type: ignore
        from spotdl.utils.search import get_simple_songs  # type: ignore
    except ImportError:
        err("Для выгрузки нужен spotDL.")
        return 1
    try:
        SpotifyClient.init(client_id=SPOTIFY_OPTIONS["client_id"],
                           client_secret=SPOTIFY_OPTIONS["client_secret"])
    except Exception as e:  # noqa: BLE001
        err(f"Не удалось подключиться к Spotify: {e}")
        return 1
    out_dir = ROOT / "Playlists"
    try:
        out_dir.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        err(f"Не удалось создать папку {shown(out_dir)}: {e}")
        return 1
    failed = 0
    for url in urls:
        say(f"Получаю список треков: {url}")
        try:
            songs = get_simple_songs([url])
        except Exception as e:  # noqa: BLE001
            err(f"Не удалось получить плейлист: {e}")
            failed += 1
            continue
        if not songs:
            err("Пусто (плейлист должен быть публичным).")
            failed += 1
            continue
        name = songs[0].list_name or (songs[0].album_name if "/album/" in url else songs[0].name)
        try:
            write_export(songs, name, url, out_dir / safe_name(name), fmt)
        except OSError as e:
            err(f"Не удалось записать выгрузку: {e}")
            failed += 1
    print("Папка: Download/Termux Downloads/Playlists/")
    return 1 if failed else 0


def write_export(songs, name, url, base, fmt):
    if fmt in ("csv", "both"):
        with open(f"{base}.csv", "w", encoding="utf-8-sig", newline="") as f:
            w = csv.writer(f)
            w.writerow(["Track name", "Artist name", "Album", "Playlist name", "Type", "ISRC", "Spotify - id"])
            for s in songs:
                w.writerow([s.name, ", ".join(s.artists or [s.artist]), s.album_name or "",
                            name, "Playlist" if "/playlist/" in url else "Album",
                            s.isrc or "", s.song_id or ""])
        ok(f"{base.name}.csv — {len(songs)} трек(ов)")
    if fmt in ("txt", "both"):
        with open(f"{base}.txt", "w", encoding="utf-8") as f:
            for s in songs:
                f.write(f"{', '.join(s.artists or [s.artist])} - {s.name}\n")
        ok(f"{base.name}.txt — {len(songs)} трек(ов)")


def common_args(p):
    p.add_argument("--name")
    p.add_argument("--numbered", action="store_true")
    p.add_argument("--yt-only", action="store_true")
    p.add_argument("--check", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--format", choices=["mp3", "m4a", "opus"], default="mp3")
    p.add_argument("--threads", type=int, default=4)
    p.add_argument("--no-lyrics", action="store_true")
    p.add_argument("-y", "--yes", action="store_true")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "export":
        p = argparse.ArgumentParser(prog="playlist-dump export")
        p.add_argument("urls", nargs="+")
        p.add_argument("--format", choices=["csv", "txt", "both"], default="both")
        a = p.parse_args(argv[1:])
        return export(a.urls, a.format)
    if argv and argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    is_link = bool(argv) and argv[0] == "link"
    if argv and argv[0] in ("download", "import", "link"):
        argv = argv[1:]
    p = argparse.ArgumentParser(prog="playlist-dump link" if is_link else "playlist-dump", add_help=False)
    common_args(p)
    if is_link:
        p.add_argument("url")
        p.add_argument("--service")
    else:
        p.add_argument("files", nargs="*", type=Path)
        p.add_argument("--keep-dump", action="store_true")
    args = p.parse_args(argv)
    args.threads = max(1, min(args.threads, 8))
    try:
        if is_link:
            return link(args.url, args)
        files = [f.expanduser() for f in args.files] or pick_file()
        if not files:
            return 1
        return download(files, args)
    except KeyboardInterrupt:
        print()
        warn("Прервано. Запустите ту же команду снова — скачанное будет пропущено.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
